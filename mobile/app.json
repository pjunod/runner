{
  "expo": {
    "name": "Noirr Runner",
    "slug": "nzbd-mobile",
    "description": "Watch and control your Runner download queue from iPhone, iPad, and Android.",
    "version": "1.1.2",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0a0a0c",
    "scheme": "nzbd",
    "ios": {
      "bundleIdentifier": "com.pjunod.nzbd",
      "buildNumber": "9",
      "supportsTablet": true,
      "requireFullScreen": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSBonjourServices": ["_nzbd._tcp"],
        "NSLocalNetworkUsageDescription": "Runner scans for and connects to download servers on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.pjunod.nzbd",
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "./plugins/withIosSceneLifecycle",
      "expo-document-picker",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
