{
  "name": "nzbd-mobile",
  "version": "1.1.8",
  "main": "index.ts",
  "dependencies": {
    "@inthepocket/react-native-service-discovery": "^0.2.9",
    "expo": "~57.0.17",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.15",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.20.1",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.5",
    "patch-package": "8.0.1",
    "typescript": "~6.0.3",
    "deepmerge": "file:vendor/deepmerge"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --configuration Release --device",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor",
    "export": "expo export --platform all",
    "postinstall": "patch-package --error-on-fail && npm run test:dependency-security",
    "test:dependency-security": "node --test vendor/deepmerge/regressions.cjs"
  },
  "overrides": {
    "uuid": "11.1.1",
    "@expo/fingerprint": {
      "minimatch": "^11.0.5"
    },
    "deepmerge": "$deepmerge"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  }
}
