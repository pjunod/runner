{
  "name": "nzbd-mobile",
  "version": "1.1.9",
  "main": "index.ts",
  "dependencies": {
    "@inthepocket/react-native-service-discovery": "^0.3.0",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "expo-doctor": "^1.20.1",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "patch-package": "8.0.1",
    "typescript": "~7.0.2",
    "deepmerge": "file:vendor/deepmerge",
    "react-test-renderer": "19.3.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --configuration Release --device",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor",
    "export": "expo export --platform all",
    "postinstall": "patch-package --error-on-fail && npm run test:dependency-security",
    "test:dependency-security": "node --test vendor/deepmerge/regressions.cjs"
  },
  "overrides": {
    "uuid": "11.1.1",
    "@expo/fingerprint": {
      "minimatch": "^11.0.5"
    },
    "deepmerge": "$deepmerge",
    "test-exclude@7": {
      "minimatch": "11.0.9",
      "glob": "14.0.6"
    },
    "@jest/reporters": {
      "glob": "14.0.6"
    },
    "jest-config": {
      "glob": "14.0.6"
    },
    "jest-runtime": {
      "glob": "14.0.6"
    },
    "test-exclude@6": {
      "glob": "7.2.3"
    }
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    },
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  }
}
