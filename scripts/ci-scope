#!/usr/bin/env bash
set -euo pipefail

base=${1:?usage: scripts/ci-scope BASE_SHA}
git cat-file -e "${base}^{commit}"
changed=()
while IFS= read -r path; do
  changed+=("$path")
done < <(git diff --name-only "$base"...HEAD)

rust=true
mobile=true
torrent=false
docs=false
docs_only=true

for path in "${changed[@]}"; do
  case "$path" in
    *.md|docs/*) docs=true ;;
    *) docs_only=false ;;
  esac
  case "$path" in
    Cargo.toml|Cargo.lock|rust-toolchain.toml|crates/*|contrib/*|Makefile|scripts/*|.github/workflows/*)
      rust=true
      ;;
  esac
  case "$path" in
    mobile/*|Cargo.toml|Cargo.lock|crates/nzbd-api/*|crates/nzbd-types/*)
      mobile=true
      ;;
  esac
  case "$path" in
    Cargo.toml|Cargo.lock|rust-toolchain.toml|crates/nzbd/*|crates/nzbd-config/*|crates/nzbd-types/*|crates/nzbd-state/*|crates/nzbd-engine/*|crates/nzbd-torrent/*|crates/nzbd-api/src/torrent_admission.rs|contrib/rqbit/*|Makefile|scripts/ci-scope|scripts/check-fast-lane-contract|scripts/check-rqbit-maintained-patch-series.sh|.github/workflows/main-fast-lane.yml)
      torrent=true
      ;;
  esac
done

printf 'rust=%s\nmobile=%s\ntorrent=%s\ndocs=%s\ndocs_only=%s\n' "$rust" "$mobile" "$torrent" "$docs" "$docs_only"
