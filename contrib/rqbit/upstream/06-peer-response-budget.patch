+// Bounds the responses a single remote peer can have queued with us: piece
+// and metadata responses triggered by its requests. A permit travels with each
+// response until the peer writer has flushed it. The limit is the same as the
+// per-peer request window (`max_request_window`) and is advertised to the peer
+// as `reqq` in the extended handshake. Admission is deliberately non-blocking:
+// a peer that exceeds the advertised window is disconnected instead of parking
+// the socket reader behind the torrent-global upload rate limiter.
+#[derive(Clone, Debug)]
+struct PeerResponseBudget {
+    limit: usize,
+    permits: Arc<Semaphore>,
+}
+
+impl PeerResponseBudget {
+    fn new(limit: usize) -> Self {
+        Self {
+            limit,
+            permits: Arc::new(Semaphore::new(limit)),
+        }
+    }
+
+    fn try_acquire(&self) -> anyhow::Result<OwnedSemaphorePermit> {
+        self.permits
+            .clone()
+            .try_acquire_owned()
+            .context("peer exceeded advertised response window")
+    }
+
+    fn advertise(&self, handshake: &mut ExtendedHandshake<ByteBuf>) {
+        handshake.reqq = Some(u32::try_from(self.limit).unwrap_or(u32::MAX));
+    }
+}
+
+type PendingUploadRequest = (ChunkInfo, OwnedSemaphorePermit);
+
+fn enqueue_piece_response(
+    budget: &PeerResponseBudget,
+    scheduler_tx: &UnboundedSender<(UnboundedSender<WriterRequest>, PendingUploadRequest)>,
+    peer_tx: &UnboundedSender<WriterRequest>,
+    chunk: ChunkInfo,
+) -> anyhow::Result<()> {
+    let permit = budget.try_acquire()?;
+    scheduler_tx
+        .send((peer_tx.clone(), (chunk, permit)))
+        .context("upload scheduler closed")
+}
+
+fn forward_piece_response(
+    peer_tx: &UnboundedSender<WriterRequest>,
+    request: PendingUploadRequest,
+) -> anyhow::Result<()> {
+    let (chunk, permit) = request;
+    peer_tx
+        .send(WriterRequest::ReadChunkRequest(chunk, permit))
+        .context("peer writer closed")
+}
+
+fn enqueue_metadata_response(
+    budget: &PeerResponseBudget,
+    peer_tx: &UnboundedSender<WriterRequest>,
+    message: UtMetadata<ByteBufOwned>,
+) -> anyhow::Result<()> {
+    let permit = budget.try_acquire()?;
+    peer_tx
+        .send(WriterRequest::UtMetadata(message, permit))
+        .context("peer writer closed")
+}
