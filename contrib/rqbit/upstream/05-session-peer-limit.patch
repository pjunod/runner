diff --git a/crates/librqbit/src/torrent_state/live/mod.rs b/crates/librqbit/src/torrent_state/live/mod.rs
index 804ef26a..ec5be881 100644
--- a/crates/librqbit/src/torrent_state/live/mod.rs
+++ b/crates/librqbit/src/torrent_state/live/mod.rs
@@ -172,6 +172,50 @@ impl TorrentStateLocked {
 
 const FLUSH_BITV_EVERY_BYTES: u64 = 16 * 1024 * 1024;
 
+struct PeerSemaphores {
+    torrent: Arc<Semaphore>,
+    session: Option<Arc<Semaphore>>,
+}
+
+struct PeerPermit {
+    _torrent: OwnedSemaphorePermit,
+    _session: Option<OwnedSemaphorePermit>,
+}
+
+impl PeerSemaphores {
+    fn new(torrent_limit: usize, session: Option<Arc<Semaphore>>) -> Self {
+        Self {
+            torrent: Arc::new(Semaphore::new(torrent_limit)),
+            session,
+        }
+    }
+
+    fn try_acquire(&self) -> Result<PeerPermit, tokio::sync::TryAcquireError> {
+        let torrent = self.torrent.clone().try_acquire_owned()?;
+        let session = self
+            .session
+            .as_ref()
+            .map(|semaphore| semaphore.clone().try_acquire_owned())
+            .transpose()?;
+        Ok(PeerPermit {
+            _torrent: torrent,
+            _session: session,
+        })
+    }
+
+    async fn acquire(&self) -> Result<PeerPermit, tokio::sync::AcquireError> {
+        let torrent = self.torrent.clone().acquire_owned().await?;
+        let session = match &self.session {
+            Some(semaphore) => Some(semaphore.clone().acquire_owned().await?),
+            None => None,
+        };
+        Ok(PeerPermit {
+            _torrent: torrent,
+            _session: session,
+        })
+    }
+}
+
 pub enum AddIncomingPeerResult {
     Added,
     AlreadyActive,
