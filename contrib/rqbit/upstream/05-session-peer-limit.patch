 }
+
+#[cfg(test)]
+mod peer_semaphore_tests {
+    use super::*;
+
+    #[test]
+    fn per_torrent_limit_is_exact() {
+        let semaphores = PeerSemaphores::new(2, None);
+        let first = semaphores.try_acquire().unwrap();
+        let _second = semaphores.try_acquire().unwrap();
+
+        assert!(semaphores.try_acquire().is_err());
+        drop(first);
+        assert!(semaphores.try_acquire().is_ok());
+    }
+
+    #[test]
+    fn session_limit_is_shared_between_torrents() {
+        let session = Arc::new(Semaphore::new(3));
+        let first_torrent = PeerSemaphores::new(2, Some(session.clone()));
+        let second_torrent = PeerSemaphores::new(2, Some(session));
+
+        let first = first_torrent.try_acquire().unwrap();
+        let _second = first_torrent.try_acquire().unwrap();
+        let _third = second_torrent.try_acquire().unwrap();
+        assert!(second_torrent.try_acquire().is_err());
+
+        drop(first);
+        assert!(second_torrent.try_acquire().is_ok());
+    }
+
+    #[tokio::test]
+    async fn waiting_peer_resumes_after_session_permit_is_released() {
+        let session = Arc::new(Semaphore::new(1));
+        let active_torrent = PeerSemaphores::new(1, Some(session.clone()));
+        let waiting_torrent = Arc::new(PeerSemaphores::new(1, Some(session)));
+        let active = active_torrent.try_acquire().unwrap();
+
+        let mut waiter = tokio::spawn({
+            let waiting_torrent = waiting_torrent.clone();
+            async move { waiting_torrent.acquire().await.unwrap() }
+        });
+        assert!(
+            tokio::time::timeout(Duration::from_millis(20), &mut waiter)
+                .await
+                .is_err()
+        );
+
+        drop(active);
+        tokio::time::timeout(Duration::from_secs(1), waiter)
+            .await
+            .unwrap()
+            .unwrap();
+    }
+}
