From: runner maintainers
Subject: [PATCH] fix XML parsing and lock the audited upstream proof graph

Resolve RUSTSEC-2026-0194 and RUSTSEC-2026-0195 without enabling
UPnP. Keep the serialize API and upstream license unchanged. Refresh
compatible dependencies used by the maintained upstream proofs, including
TLS, runtime, deserialization, memory mapping and test instrumentation.

diff --git a/crates/upnp/Cargo.toml b/crates/upnp/Cargo.toml
--- a/crates/upnp/Cargo.toml
+++ b/crates/upnp/Cargo.toml
@@ -22,7 +22,7 @@
 network-interface = { version = "2" }
 httparse = "1.9.4"
 bstr = "1.10.0"
-quick-xml = { version = "0.37.1", features = ["serialize"] }
+quick-xml = { version = "0.41.0", features = ["serialize"] }
 
 [dev-dependencies]
 tokio = { version = "1", features = ["macros", "rt-multi-thread"] }

diff --git a/crates/upnp-serve/Cargo.toml b/crates/upnp-serve/Cargo.toml
--- a/crates/upnp-serve/Cargo.toml
+++ b/crates/upnp-serve/Cargo.toml
@@ -36,7 +36,7 @@
 tokio-util = "0.7.11"
 reqwest = { version = "0.12.7", default-features = false }
 socket2 = "0.5.7"
-quick-xml = { version = "0.37.1", features = ["serialize"] }
+quick-xml = { version = "0.41.0", features = ["serialize"] }
 network-interface = "2.0.0"
 futures = "0.3.30"
 

