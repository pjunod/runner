From: runner maintainers
Subject: [PATCH] bound bencode list/dict nesting depth

Extended peer messages with an unknown id decode untrusted bytes into the
recursive BencodeValue. List and dict decoding recursed once per opener
with no limit, so a single frame of nested openers overflowed the
decoding thread's stack and aborted the process. Reject nesting deeper
than 64 levels with an ordinary decode error.

diff --git a/crates/bencode/src/serde_bencode_de.rs b/crates/bencode/src/serde_bencode_de.rs
index a21d8cb..2f0cabc 100644
--- a/crates/bencode/src/serde_bencode_de.rs
+++ b/crates/bencode/src/serde_bencode_de.rs
@@ -1,10 +1,16 @@
 use buffers::ByteBuf;
 use serde::de::Error as DeError;
 
+/// Deepest list/dict nesting accepted from input. Real torrent metadata and
+/// peer extension payloads nest only a few levels; unbounded nesting lets a
+/// peer exhaust the decoding thread's stack, which aborts the process.
+pub const MAX_NESTING_DEPTH: usize = 64;
+
 pub struct BencodeDeserializer<'de> {
     buf: &'de [u8],
     field_context: Vec<ByteBuf<'de>>,
     parsing_key: bool,
+    depth: usize,
 
     // This is a f**ing hack
     pub is_torrent_info: bool,
@@ -18,6 +24,7 @@ impl<'de> BencodeDeserializer<'de> {
             buf,
             field_context: Default::default(),
             parsing_key: false,
+            depth: 0,
             is_torrent_info: false,
             torrent_info_digest: None,
             torrent_info_bytes: None,
@@ -26,6 +33,19 @@ impl<'de> BencodeDeserializer<'de> {
     pub fn into_remaining(self) -> &'de [u8] {
         self.buf
     }
+
+    fn nested<T>(&mut self, f: impl FnOnce(&mut Self) -> Result<T, Error>) -> Result<T, Error> {
+        if self.depth >= MAX_NESTING_DEPTH {
+            return Err(Error::custom(format!(
+                "bencode nesting deeper than {MAX_NESTING_DEPTH} levels"
+            ))
+            .set_context(self));
+        }
+        self.depth += 1;
+        let result = f(self);
+        self.depth -= 1;
+        result
+    }
     fn parse_integer(&mut self) -> Result<i64, Error> {
         match self.buf.iter().copied().position(|e| e == b'e') {
             Some(end) => {
@@ -444,9 +464,11 @@ impl<'de> serde::de::Deserializer<'de> for &mut BencodeDeserializer<'de> {
             )));
         }
         self.buf = self.buf.get(1..).unwrap_or_default();
-        visitor
-            .visit_seq(SeqAccess { de: self })
-            .map_err(|e: Self::Error| e.set_context(self))
